<Project>

  <PropertyGroup>
    <!-- Commit a packages.lock.json per project. This is what lets GitHub build the
         NuGet transitive graph — without it Dependabot raises no NuGet alerts at all,
         and Renovate only ever sees top-level PackageReferences. CVE-2025-6965 sat
         unflagged in a transitive SQLitePCLRaw for exactly that reason.

         CI restores without locked mode. Renovate has refreshed the lock files along
         with the csproj on every bump so far, so this is headroom rather than a
         workaround: if one ever does drift, restore updates it in place instead of
         hard-failing the PR. Recover with
         `dotnet restore /p:RestoreForceEvaluate=true` and commit the result. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
