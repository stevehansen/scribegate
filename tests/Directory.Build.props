<Project>

  <!-- MSBuild stops at the nearest Directory.Build.props, so without this the root
       one never applies to test projects. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFileName)$(MSBuildThisFileExtension), $(MSBuildThisFileDirectory)../))" />

  <PropertyGroup>
    <!-- xUnit v3 recommends threading TestContext.Current.CancellationToken
         through every async call. For the seed tests we keep things minimal;
         suppressing is documented and a follow-up item for later. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

</Project>
